/******************************************************************* 
 FORMULA NAME: MMC_BEN_NEWLY_BENEFITS_ELIGIBLE
 FORMULA TYPE: Person Changes Causes Life Event 
DESCRIPTION: used when teammates are now eligible for benefits
Changes:
10/08/2025 - RPUTHOFF - Initial Version
 **********************************************************************/ 
 Inputs are BEN_ASG_IO_NORMAL_HOURS(number),BEN_ASG_IN_NORMAL_HOURS(number), BEN_ASG_IN_EMPLOYMENT_CATEGORY (text), BEN_ASG_IO_EMPLOYMENT_CATEGORY (text)

 DEFAULT FOR BEN_ASG_IN_NORMAL_HOURS IS 40 
 DEFAULT FOR BEN_ASG_IO_NORMAL_HOURS IS 40
 DEFAULT FOR BEN_ASG_IN_EMPLOYMENT_CATEGORY IS 'X' 
 DEFAULT FOR BEN_ASG_IO_EMPLOYMENT_CATEGORY IS 'Y' 

 l_return = 'N' 

 IF (
    /*Old Emp_Cat = Seasonal, Casual, Temp and new assignment category is FT Reg */
    ((BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'CAS' OR BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'PT' OR BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'FT' OR BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'SEAS' OR BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'S_COOP') AND BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'FR')
    OR
    /*Old Emp_Cat = Seasonal, Casual, Temp and new assignment category is PR */
    ((BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'CAS' OR BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'PT' OR BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'FT' OR BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'SEAS' OR BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'S_COOP') AND BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'PR')
    OR
     /* PR < 20 to PR>=20*/
     (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'PR' AND BEN_ASG_IO_NORMAL_HOURS < 20 AND
      BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'PR' AND BEN_ASG_IN_NORMAL_HOURS >= 20)
     OR
     /* PR < 20 to FR */
     (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'PR' AND BEN_ASG_IO_NORMAL_HOURS < 20 AND
      BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'FR')
     OR
     /* S_COOP < 30 to S_COOP >=30 */
     (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'S_COOP' AND BEN_ASG_IO_NORMAL_HOURS < 30 AND
      BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'S_COOP' AND BEN_ASG_IN_NORMAL_HOURS >= 30)
     OR
     /* S_COOP < 30 to PR >=20 */
     (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'S_COOP' AND BEN_ASG_IO_NORMAL_HOURS < 30 AND 
      BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'PR' AND BEN_ASG_IN_NORMAL_HOURS >= 20)
 )
 THEN 
 (l_return = 'Y') 
 ELSE 
 (l_return = 'N') 

 RETURN l_return