/******************************************************************* 
 FORMULA NAME: MMC_BEN_NO_LONGER_BENEFITS_ELIGIBLE
 FORMULA TYPE: Person Changes Causes Life Event 
DESCRIPTION: used when teammates are no longer eligible for benefits
Changes:
10/08/2025 - RPUTHOFF - Initial Version
 **********************************************************************/ 
 Inputs are BEN_ASG_IO_NORMAL_HOURS(number),BEN_ASG_IN_NORMAL_HOURS(number), BEN_ASG_IN_EMPLOYMENT_CATEGORY (text), BEN_ASG_IO_EMPLOYMENT_CATEGORY (text)

 DEFAULT FOR BEN_ASG_IN_NORMAL_HOURS IS 40 
 DEFAULT FOR BEN_ASG_IO_NORMAL_HOURS IS 40
 DEFAULT FOR BEN_ASG_IN_EMPLOYMENT_CATEGORY IS 'X' 
 DEFAULT FOR BEN_ASG_IO_EMPLOYMENT_CATEGORY IS 'Y' 

 l_return = 'N' 

 IF (
    /*Full-time Regular to Part-time Regular < 20*/
    (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'FR' AND BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'PR' AND BEN_ASG_IN_NORMAL_HOURS < 20)
    OR
    /*Full-time Regular to Student < 30*/
    (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'FR' AND BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'S_COOP' AND BEN_ASG_IN_NORMAL_HOURS < 30)
    OR
    /*PT Reg >= 20 to PT Reg < 20*/
    (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'PR' AND BEN_ASG_IO_NORMAL_HOURS >= 20 AND BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'PR' AND BEN_ASG_IN_NORMAL_HOURS < 20)
    OR
    /*PT Reg >= 20 to Student < 30*/
    (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'PR' AND BEN_ASG_IO_NORMAL_HOURS >= 20 AND BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'S_COOP' AND BEN_ASG_IN_NORMAL_HOURS < 30)
    OR
    /*Student >= 30 to student < 30*/
    (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'S_COOP' AND BEN_ASG_IO_NORMAL_HOURS >= 30 AND BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'S_COOP' AND BEN_ASG_IN_NORMAL_HOURS < 30)
    OR
    /*Full-time Regular to FT/PT Temps or Casual*/
    (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'FR' AND (BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'FT' OR BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'PT' OR BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'CAS'))
    OR
    /*Part-time Regular >=20 to FT/PT Temps or Casual*/
    (BEN_ASG_IO_EMPLOYMENT_CATEGORY = 'PR' AND BEN_ASG_IO_NORMAL_HOURS >= 20 AND (BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'FT' OR BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'PT' OR BEN_ASG_IN_EMPLOYMENT_CATEGORY = 'CAS'))
 )
 THEN 
 (l_return = 'Y') 
 ELSE 
 (l_return = 'N') 

 RETURN l_return